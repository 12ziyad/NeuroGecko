# THE ROOT PATH WAS NOT COVERED. `/*.html` does not match `/`, which is the URL
# everyone actually opens, so the index kept being served from the edge cache
# while every module beside it was current -- three deploys that appeared to do
# nothing. `/*` catches it.
/*
  Cache-Control: public, max-age=60, must-revalidate
/*.js
  Cache-Control: public, max-age=60, must-revalidate
/media/*
  Cache-Control: public, max-age=300, must-revalidate

# AND `/*` CAUGHT THE API TOO, which is the same mistake pointed the other way.
# The contact endpoint sets its own `no-store`, and this file was overriding it:
# the counter read 1 from the edge for as long as anyone cared to watch while KV
# held a different number entirely. A live count served from a cache is not a
# live count. Rules are applied in order, so this one wins.
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

# The admin page is behind a key, but it should not be in a search index or an
# edge cache either. Belt and braces.
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
